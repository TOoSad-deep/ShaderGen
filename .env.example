# ShaderGen Direct runtime. Copy to .env and never commit real credentials.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ShaderGen
LANGSMITH_API_KEY=

SHADER_GEN_MODEL_NAME=dashscope:qwen3.7-plus
SHADER_GEN_QWEN_ENABLE_THINKING=
SHADER_GEN_QWEN_OUTPUT_THINKING=false

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
SHADER_GEN_KIMI_REASONING_EFFORT=low
OPENAI_API_KEY=
OPENAI_BASE_URL=

LOG_LEVEL=INFO
SHADERGEN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SHADERGEN_PUBLIC_ARTIFACT_ROOT=output/png-to-shader
SHADERGEN_PRIVATE_ATTEMPT_ARTIFACT_ROOT=output/png-to-shader-direct-private
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/SHADERGEN_TEST
