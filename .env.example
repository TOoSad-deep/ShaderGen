# 本文件只包含 Agent、Backend、Node Lab Service 与仓库脚本读取的服务端变量。
# 复制为根目录 .env 后按需填写；不要提交真实密钥。
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ShaderGen
LANGSMITH_API_KEY=

SHADER_GEN_MODEL_NAME=dashscope:qwen3.7-plus
SHADER_GEN_QWEN_ENABLE_THINKING=
SHADER_GEN_QWEN_OUTPUT_THINKING=false

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
SHADER_GEN_KIMI_REASONING_EFFORT=low
OPENAI_API_KEY=
OPENAI_BASE_URL=

LOG_LEVEL=INFO
SHADERGEN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 只允许 Backend 读取的受信 engine policy；留空等价于 disabled/旧引擎。
SHADERGEN_ENGINE_POLICY_PATH=
# canary/direct-default 必填；当前 registry 没有 durable promotion entry。
SHADERGEN_EVIDENCE_REGISTRY_PATH=
# 新请求紧急回滚开关，仅接受 0/1；1 强制旧引擎并允许启动时跳过 promotion registry，
# 但受信 policy YAML 本身仍必须严格解析。
SHADERGEN_DIRECT_GLSL_KILL_SWITCH=0
# canary/direct-default child attempt 私有根；不得与公开根或 production-shadow
# 私有根相同，也不得在任一方向嵌套。
SHADERGEN_ENGINE_ROLLOUT_PRIVATE_ARTIFACT_ROOT=output/png-to-shader-rollout-private
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/SHADERGEN_TEST
LANGGRAPH_STRICT_MSGPACK=true

# Node Lab 独立服务；factory 模块及其 Provider/Node 必须安装在服务环境。
# 测试当前 12 个 scene_mvp Node 时可显式设为：
# agent.app.services.node_lab:create_application
NODELAB_ROOT=output/node-lab/service
NODELAB_BATCH_ROOT=output/benchmarks/node-lab-service
NODELAB_PIPELINE_ID=node_lab
NODELAB_APPLICATION_FACTORY=
NODELAB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODELAB_LOG_LEVEL=INFO
NODELAB_REAL_MODEL_ENABLED=false
